.DS_Store
DerivedData/
build/
*.xcresult
*.dSYM
*.xcuserstate
xcuserdata/

# Upload these from the local release folder as GitHub Release assets;
# do not commit generated binaries to source history.
release/**/*.app/
release/**/*.dmg

# Final marketing assets are published with the repository. Raw captures and
# local generation tooling remain local-only.
marketing/source/*

# Archives and source backups stay local; they are not source.
*.zip
*.film-backup
*.pre-*-backup
